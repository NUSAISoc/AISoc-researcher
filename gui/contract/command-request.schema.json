{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-request.schema.json",
  "title": "Command request body",
  "type": "object",
  "required": [
    "rationale",
    "expectedVersion",
    "requestId"
  ],
  "properties": {
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "expectedVersion": {
      "type": "integer"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "into": {
      "type": "string"
    }
  }
}
